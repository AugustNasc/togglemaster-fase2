{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "targeting-service",
        "namespace": "tm-targeting"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "targeting-service"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "targeting-service"
            }
          },
          "spec": {
            "containers": [
              {
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "app-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "app-secrets"
                    }
                  }
                ],
                "image": "699191579246.dkr.ecr.us-east-2.amazonaws.com/targeting-service:fase2-v2",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": 8003,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "app",
                "ports": [
                  {
                    "containerPort": 8003,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": 8003,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "failureThreshold": 30,
                  "httpGet": {
                    "path": "/health",
                    "port": 8003,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 65534,
              "runAsNonRoot": true,
              "runAsUser": 10001
            },
            "serviceAccount": "targeting-service",
            "serviceAccountName": "targeting-service",
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "targeting-service",
        "namespace": "tm-targeting"
      },
      "spec": {
        "internalTrafficPolicy": "Cluster",
        "ports": [
          {
            "port": 8003,
            "protocol": "TCP",
            "targetPort": 8003
          }
        ],
        "selector": {
          "app": "targeting-service"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "AUTH_SERVICE_URL": "http://auth-service.tm-auth.svc.cluster.local:8001",
        "PORT": "8003"
      },
      "kind": "ConfigMap",
      "metadata": {
        "name": "app-config",
        "namespace": "tm-targeting"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "targeting-service",
        "namespace": "tm-targeting"
      }
    }
  ]
}