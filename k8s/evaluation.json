{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "evaluation-service",
        "namespace": "tm-evaluation"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "evaluation-service"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "evaluation-service"
            }
          },
          "spec": {
            "containers": [
              {
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "app-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "app-secrets"
                    }
                  }
                ],
                "image": "699191579246.dkr.ecr.us-east-2.amazonaws.com/evaluation-service:fase2-v2",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": 8004,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "app",
                "ports": [
                  {
                    "containerPort": 8004,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": 8004,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "failureThreshold": 30,
                  "httpGet": {
                    "path": "/health",
                    "port": 8004,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 65534,
              "runAsNonRoot": true,
              "runAsUser": 10001
            },
            "serviceAccount": "evaluation-service",
            "serviceAccountName": "evaluation-service",
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "evaluation-service",
        "namespace": "tm-evaluation"
      },
      "spec": {
        "internalTrafficPolicy": "Cluster",
        "ports": [
          {
            "port": 8004,
            "protocol": "TCP",
            "targetPort": 8004
          }
        ],
        "selector": {
          "app": "evaluation-service"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "AWS_REGION": "us-east-2",
        "FLAG_SERVICE_URL": "http://flag-service.tm-flag.svc.cluster.local:8002",
        "PORT": "8004",
        "TARGETING_SERVICE_URL": "http://targeting-service.tm-targeting.svc.cluster.local:8003"
      },
      "kind": "ConfigMap",
      "metadata": {
        "name": "app-config",
        "namespace": "tm-evaluation"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "evaluation-service",
        "namespace": "tm-evaluation"
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "evaluation",
        "namespace": "tm-evaluation"
      },
      "spec": {
        "maxReplicas": 5,
        "metrics": [
          {
            "resource": {
              "name": "cpu",
              "target": {
                "averageUtilization": 70,
                "type": "Utilization"
              }
            },
            "type": "Resource"
          }
        ],
        "minReplicas": 1,
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "evaluation-service"
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "evaluation-public",
        "namespace": "tm-evaluation"
      },
      "spec": {
        "ingressClassName": "nginx",
        "rules": [
          {
            "host": "k8s-nginxing-togglema-8f6e8dfb5a-abc942c96fbc4fd8.elb.us-east-2.amazonaws.com",
            "http": {
              "paths": [
                {
                  "backend": {
                    "service": {
                      "name": "evaluation-service",
                      "port": {
                        "number": 8004
                      }
                    }
                  },
                  "path": "/evaluate",
                  "pathType": "Exact"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}